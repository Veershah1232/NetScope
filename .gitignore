# .gitignore — NetScope

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
venv/
.venv/
env/
.env

# Secrets — NEVER COMMIT THESE
.env.local
secrets.yaml
credentials.json
*.key
*.pem
*.cert

# Data / output (large files)
results/
data/
benchmarks/storage_results/
*.jsonl
*.parquet
*.csv
*.csv.gz

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker local volumes
docker_volumes/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/
